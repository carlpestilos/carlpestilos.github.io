    <script>
      // Everything is measured once (and again on resize), so the scroll handler
      // does arithmetic only: no layout reads, no layout-changing writes per frame.
      const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-stack]'));
      const bar = document.getElementById('scroll-progress');
      const dotNav = document.getElementById('dot-nav');
      const topNav = document.getElementById('top-nav');
      const dotLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#dot-nav a'));
      const topLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#top-nav a'));
      const pipe = document.getElementById('pipe');
      const spine = pipe ? pipe.querySelector<HTMLElement>('.spine') : null;
      const pipeIndex = sections.findIndex((el) => el.id === 'pipeline');
      const stages = pipe ? Array.from(pipe.querySelectorAll<HTMLElement>('.stage')) : [];

      let heights: number[] = [];
      let tops: number[] = [];
      let docHeight = 0;
      let spineOffset = 0;
      let spineHeight = 0;
      let nodeOffsets: number[] = [];

      let queued = false;
      let lastActive = -1;
      let lastP = -1;
      const reachedState: boolean[] = stages.map(() => false);
      const coveredState: boolean[] = sections.map(() => false);

      function queue() {
        if (!queued) {
          queued = true;
          requestAnimationFrame(frame);
        }
      }

      // Sections taller than the screen stay in normal scroll until their bottom
      // edge reaches the bottom of the viewport, then pin, so no text is ever
      // covered before it has been seen. Shorter sections pin at the top.
      function measure() {
        const vh = window.innerHeight;
        heights = sections.map((el) => el.offsetHeight);
        let acc = 0;
        tops = heights.map((h) => {
          const t = acc;
          acc += h;
          return t;
        });
        docHeight = acc;
        sections.forEach((el, i) => {
          el.style.top = `${Math.min(0, vh - heights[i])}px`;
        });

        if (spine && pipeIndex >= 0) {
          const sr = sections[pipeIndex].getBoundingClientRect();
          const pr = spine.getBoundingClientRect();
          spineOffset = pr.top - sr.top;
          spineHeight = pr.height;
          spine.style.setProperty('--sh', `${spineHeight}px`);
          nodeOffsets = stages.map((s) => {
            const n = s.querySelector('.node')!.getBoundingClientRect();
            return n.top + n.height / 2 - sr.top;
          });
        }
        lastP = -1;
        queue();
      }

      function frame() {
        queued = false;
        if (!tops.length) return;

        const vh = window.innerHeight;
        const y = window.scrollY;
        // Where a section sits on screen right now, including its pinned position
        const topOf = (i: number) => Math.max(tops[i] - y, Math.min(0, vh - heights[i]));

        // progress bar
        const max = docHeight - vh;
        const progress = max > 0 ? y / max : 0;
        if (bar) bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;

        // active section (top toolbar + side dots)
        const probe = y + vh * 0.4;
        let active = 0;
        for (let i = 0; i < tops.length; i++) if (tops[i] <= probe) active = i;
        if (active !== lastActive) {
          lastActive = active;
          [dotLinks, topLinks].forEach((links) =>
            links.forEach((link, i) => {
              link.classList.toggle('is-active', i === active);
              if (i === active) link.setAttribute('aria-current', 'true');
              else link.removeAttribute('aria-current');
            })
          );
        }

        // a section that the next one fully covers stops animating
        for (let i = 0; i < sections.length - 1; i++) {
          const t = topOf(i + 1);
          const covered = t <= -80 && t + heights[i + 1] >= vh - 1;
          if (covered !== coveredState[i]) {
            coveredState[i] = covered;
            sections[i].classList.toggle('is-covered', covered);
          }
        }

        // process section: spine fill, travelling dot, stage activation
        if (spine && pipeIndex >= 0) {
          const st = topOf(pipeIndex);
          const secBottom = st + heights[pipeIndex];
          // The reading line sits at 55% of the screen, then slides to the bottom as the
          // section reaches its pinned position, so the last stage always lights up.
          const k = Math.min(1, Math.max(0, (vh * 1.5 - secBottom) / (vh * 0.5)));
          const line = vh * 0.55 + vh * 0.45 * k;
          const p = spineHeight > 0 ? Math.min(1, Math.max(0, (line - (st + spineOffset)) / spineHeight)) : 0;
          if (Math.abs(p - lastP) > 0.0005) {
            lastP = p;
            spine.style.setProperty('--p', p.toFixed(4));
          }
          stages.forEach((s, i) => {
            const reached = st + nodeOffsets[i] < line;
            if (reached !== reachedState[i]) {
              reachedState[i] = reached;
              s.classList.toggle('reached', reached);
            }
          });
        }
      }

      // navigation clicks
      const goTo = (i: number) => (e: Event) => {
        e.preventDefault();
        window.scrollTo({ top: tops[i], behavior: 'smooth' });
      };
      dotLinks.forEach((link, i) => link.addEventListener('click', goTo(i)));
      topLinks.forEach((link, i) => link.addEventListener('click', goTo(i)));

      // side dots stay hidden until the top toolbar has scrolled out of view
      if ('IntersectionObserver' in window) {
        if (topNav && dotNav) {
          new IntersectionObserver(([entry]) => {
            dotNav.classList.toggle('is-visible', !entry.isIntersecting);
