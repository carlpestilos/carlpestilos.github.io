---
// ---------------------------------------------------------------
// PROFILE PICTURE: put your photo in the /public folder and set
// the file name here. Example: public/profile.jpg  ->  "/profile.jpg"
// A square image (at least 400x400) works best.
// ---------------------------------------------------------------
const profilePhoto = "/profile.jpg";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carl Pestilos - Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-canvas text-ink font-sans m-0 p-0 antialiased overflow-x-clip">

    <!-- Scroll progress bar -->
    <div id="scroll-progress" aria-hidden="true"></div>

    <!-- Side dot navigation (wide screens only) -->
    <nav id="dot-nav" aria-label="Page sections">
      <a href="#home" class="is-active" aria-label="Home"><span class="dot-label">Home</span></a>
      <a href="#pipeline" aria-label="Pipeline"><span class="dot-label">Pipeline</span></a>
      <a href="#experience" aria-label="Experience"><span class="dot-label">Experience</span></a>
      <a href="#skills" aria-label="Skills"><span class="dot-label">Skills</span></a>
      <a href="#education" aria-label="Education"><span class="dot-label">Education</span></a>
    </nav>

    <!-- 1. HERO SECTION -->
    <section id="home" data-stack style="z-index:1" class="hero-pastel-mesh w-full px-6 pt-32 pb-20 text-center flex flex-col items-center">
      <div class="side-deco" style="--ay:35%;--by:85%" aria-hidden="true">
        <div class="deco-pipe"></div>

        <div class="deco-card deco-left" style="top:24%;--d:-1s">
          <div class="card-head">Hub_Sheet</div>
          <div class="sheet-grid"><i class="hl"></i><i></i><i></i><i class="ok"></i><i></i><i class="hl"></i><i class="ok"></i><i></i><i class="ok"></i><i></i><i></i><i class="hl"></i><i></i><i class="ok"></i><i></i><i></i></div>
        </div>

        <div class="deco-card deco-left" style="top:64%;--d:-3s">
          <div class="card-head"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Mail Merge</div>
          <div class="bar"><span></span></div>
          <div class="meta">80+ hrs → 20 min</div>
        </div>

        <div class="deco-card deco-right" style="top:20%;--d:-2s">
          <div class="card-head"><span class="traffic"></span>sync.gs</div>
<pre><span class="k">function</span> <span class="f">syncHub</span>() &#123;
  <span class="k">const</span> rows = pull();
  hub.<span class="f">write</span>(rows);
&#125;</pre>
        </div>

        <div class="deco-card deco-right" style="top:60%;--d:-4s">
          <div class="card-head"><svg class="ico spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>Auto-sync<span class="live"></span></div>
          <div class="meta">every 30 min</div>
        </div>
      </div>
      <div class="max-w-3xl mx-auto z-10 relative animate-fade-up">

        <!-- ============ PROFILE PICTURE (edit `profilePhoto` at the top of this file) ============ -->
        <div class="relative w-36 h-36 md:w-44 md:h-44 mx-auto mb-8 rounded-full overflow-hidden border-4 border-white shadow-xl bg-canvas-lavender flex items-center justify-center">
          <!-- Fallback initials, visible only if the image is missing -->
          <span class="text-4xl md:text-5xl font-bold text-primary select-none">CP</span>
          <img
            src={profilePhoto}
            alt="Portrait of Carl Pestilos"
            class="absolute inset-0 w-full h-full object-cover"
            onerror="this.style.display='none'"
          />
        </div>
        <!-- ============ END PROFILE PICTURE ============ -->

        <h1 class="text-5xl md:text-[64px] font-bold tracking-tight text-ink mb-6 leading-tight" style="letter-spacing: -0.768px;">Carl Pestilos</h1>
        <p class="text-xl md:text-2xl mb-10 text-ink font-bold">Senior Accounting Operations Specialist & Workflow Automation</p>
        
        <p class="text-base text-ink-mute max-w-2xl mx-auto mb-12 leading-relaxed">
          Detail-oriented professional specializing in optimizing financial operations for Homeowners Associations (HOAs) and automating complex workflows. Proven track record of mitigating collection fees, liens, and legal actions while preventing significant monthly late fees for clients.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
          <a href="mailto:carlpestilos2@gmail.com" class="flex items-center justify-center gap-2 bg-primary text-on-primary font-bold text-base px-7 py-3.5 rounded-pill hover:bg-primary-press transition-all hover:scale-105 tracking-wide shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            CONTACT ME
          </a>
          <a href="https://linkedin.com/in/carl-pestilos/" target="_blank" class="flex items-center justify-center gap-2 bg-canvas border-2 border-primary text-primary font-bold text-base px-7 py-3.5 rounded-pill hover:bg-canvas-cream transition-all hover:scale-105 tracking-wide shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            LINKEDIN PROFILE
          </a>
        </div>
      </div>
      
      <!-- Interactive Workflow Infographic -->
      <div class="ui-mockup w-full max-w-5xl bg-canvas flex flex-col rounded-[16px] shadow-2xl relative z-10 overflow-hidden border border-gray-200 mt-4 animate-fade-up delay-1">
         <div class="bg-surface-aubergine h-12 w-full flex items-center px-4 gap-2">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
            <span class="ml-4 text-white/70 font-mono text-xs flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
              workflow_automation_pipeline.gs
            </span>
         </div>
         
         <div class="bg-canvas-lavender flex-grow flex flex-col items-center justify-center p-6 md:p-16 text-center">
           <div class="flex flex-col md:flex-row items-center gap-8 md:gap-0 w-full max-w-4xl relative z-10">
             <!-- Phone-only vertical connector (the desktop version is the horizontal line below) -->
             <div class="flow-v md:hidden -z-10" aria-hidden="true"></div>
             <div class="bg-canvas p-6 rounded-xl shadow-md border border-gray-100 flex-1 w-full md:w-auto z-10">
               <div class="w-12 h-12 bg-canvas-cream text-primary rounded-full flex items-center justify-center mb-4 mx-auto border border-gray-200">
                 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
               </div>
               <h4 class="font-bold text-primary mb-1">Raw HOA Data</h4>
               <p class="text-xs text-ink-mute">6,000+ Properties</p>
             </div>

             <div class="flex flex-col items-center flex-1 w-full md:w-auto z-0 md:-mx-4 my-4 md:my-0">
               <div class="hidden md:block h-1 w-full bg-primary/20 absolute top-1/2 -translate-y-1/2 left-0 right-0 -z-10"></div>
               <span class="md:hidden flex items-center justify-center w-7 h-7 rounded-full bg-canvas-lavender text-primary mb-3" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
               <div class="bg-primary text-on-primary px-5 py-2.5 rounded-pill text-sm font-bold shadow-lg whitespace-nowrap z-10 flex items-center gap-2">
                 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                 Apps Script Pipeline
               </div>
               <p class="text-[11px] font-mono text-primary-tint mt-4 bg-white md:bg-primary/5 px-3 py-1.5 rounded-md block border border-primary/10">bypass_importrange()</p>
               <span class="md:hidden flex items-center justify-center w-7 h-7 rounded-full bg-canvas-lavender text-primary mt-3" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
             </div>

             <div class="bg-surface-aubergine p-6 rounded-xl shadow-md border border-gray-100 flex-1 w-full md:w-auto z-10">
               <div class="w-12 h-12 bg-primary-press text-white rounded-full flex items-center justify-center mb-4 mx-auto border border-primary-tint">
                 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
               </div>
               <h4 class="font-bold text-on-primary mb-1">Central Hub</h4>
               <p class="text-xs text-on-aubergine-mute">Auto-Synced Every 30m</p>
             </div>
           </div>

           <div class="flex flex-col md:flex-row gap-8 md:gap-16 mt-12 pt-8 border-t border-primary/10 w-full justify-center">
              <div class="text-center">
                <span class="block text-4xl font-bold text-primary tracking-tight mb-1">$100k</span>
                <span class="text-xs text-ink-mute font-bold uppercase tracking-wider">Monthly Fees Prevented</span>
              </div>
              <div class="text-center md:border-l md:border-primary/10 md:pl-16">
                <span class="block text-4xl font-bold text-primary tracking-tight mb-1">80%</span>
                <span class="text-xs text-ink-mute font-bold uppercase tracking-wider">Manual Entry Reduced</span>
              </div>
           </div>
         </div>
      </div>
    </section>

    <!-- 2. PROCESS SECTION: how a property stays current and compliant -->
    <section id="pipeline" data-stack style="z-index:2" class="stack-card pipe-section py-24">
      <div class="max-w-5xl mx-auto px-6">

        <div class="text-center mb-20 max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-ink mb-4" style="letter-spacing:-0.4px;">
            A system that keeps every property in good standing with its HOA
          </h2>
          <p class="text-ink-mute leading-relaxed">
            Every property we manage answers to an HOA, and every HOA works through its own channels
            and timelines. I built the tools that turn that into one automated workflow: requests go out,
            documents come in, files are named and uploaded, and the master file keeps itself current.
            Requesting, compiling and uploading used to be done by hand. Now we always know where each
            property stands.
          </p>
        </div>

        <div class="pipe" id="pipe">
          <div class="spine" aria-hidden="true">
            <div class="spine-fill"></div>
          </div>

          <!-- 1 · REQUEST -->
          <article class="stage">
            <span class="node" aria-hidden="true">1</span>
            <div class="stage-text">
              <h3>Requests go out in minutes</h3>
              <p>Requests to HOAs and management companies no longer go out one email at a time. A custom mail merge sends individualized emails in about 20 minutes, a job that used to take over 80 hours. Phone calls and mailed requests cover the rest.</p>
              <span class="stat">80+ hrs → 20 min</span>
            </div>
            <div class="stage-visual">
              <div class="vis">
                <div class="vis-head">Requests out</div>
                <div class="mails"><span style="--i:0">✉</span><span style="--i:1">✉</span><span style="--i:2">✉</span><span style="--i:3">✉</span><span style="--i:4">✉</span></div>
                <div class="bar"><span></span></div>
                <div class="meta">Email via mail merge, phone, post</div>
              </div>
            </div>
          </article>

          <!-- 2 · COLLECT -->
          <article class="stage">
            <span class="node" aria-hidden="true">2</span>
            <div class="stage-text">
              <h3>Every channel feeds one pipeline</h3>
              <p>HOAs respond through whichever channel they use: the portals we are already registered on, email, phone, or mail. Whichever one it is, the information is captured in the same place.</p>
              <span class="stat">4 channels, 1 destination</span>
            </div>
            <div class="stage-visual">
              <div class="vis">
                <div class="vis-head">Incoming</div>
                <div class="chips">
                  <span style="--i:0">Portal</span><span style="--i:1">Email</span><span style="--i:2">Phone</span><span style="--i:3">Mail</span>
                </div>
                <div class="funnel"></div>
                <div class="hubbar">Documents in <em>receiving…</em></div>
              </div>
            </div>
          </article>

          <!-- 3 · PROJECT SHEETS -->
          <article class="stage">
            <span class="node" aria-hidden="true">3</span>
            <div class="stage-text">
              <h3>Each project has its own source of truth</h3>
              <p>Our spreadsheets are segregated by project. Whatever an HOA sends back is recorded in the sheet for that project, so every workstream stays organized.</p>
              <span class="stat">One sheet per project</span>
            </div>
            <div class="stage-visual">
              <div class="vis">
                <div class="vis-head">Project sheets</div>
                <div class="tabs"><b class="on">Project A</b><b>Project B</b><b>Project C</b></div>
                <div class="sheet">
                  <div class="row th"><b>Property</b><b>Asked</b><b>Got</b><b>Status</b></div>
                  <div class="row"><i></i><i class="t1"></i><i class="land" style="--i:0"></i><i class="land" style="--i:0"></i></div>
                  <div class="row"><i></i><i class="t1"></i><i class="land" style="--i:1"></i><i class="land" style="--i:1"></i></div>
                  <div class="row"><i></i><i class="t1"></i><i class="land" style="--i:2"></i><i class="land" style="--i:2"></i></div>
                  <div class="row"><i></i><i class="t1"></i><i class="land" style="--i:3"></i><i class="land" style="--i:3"></i></div>
                </div>
              </div>
            </div>
          </article>

          <!-- 4 · MASTER FILE -->
          <article class="stage">
            <span class="node" aria-hidden="true">4</span>
            <div class="stage-text">
              <h3>One master file shows every property</h3>
              <p>A master file brings every project type into a single view. Apps Script updates it on a set interval and pushes each property's portal data alongside its record, so current status is always one glance away.</p>
              <span class="stat">Auto-updates every 30 min</span>
            </div>
            <div class="stage-visual">
              <div class="vis">
                <div class="vis-head">
                  Master file
                  <span class="sync"><svg class="spin-slow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>every 30 min</span>
                </div>
                <div class="sheet m3">
                  <div class="row th"><b>Property</b><b>Projects</b><b>Portal data</b></div>
                  <div class="row"><i></i><i class="t1"></i><i class="p" style="--i:0"></i></div>
                  <div class="row"><i></i><i class="t2"></i><i class="p" style="--i:1"></i></div>
                  <div class="row"><i></i><i class="t3"></i><i class="p" style="--i:2"></i></div>
                  <div class="row"><i></i><i class="t1"></i><i class="p" style="--i:3"></i></div>
                  <div class="row"><i></i><i class="t2"></i><i class="p" style="--i:4"></i></div>
                </div>
              </div>
            </div>
          </article>

          <!-- 5 · RENAME -->
          <article class="stage">
            <span class="node" aria-hidden="true">5</span>
            <div class="stage-text">
              <h3>Consistent file names, built in</h3>
              <p>A tool I built renames each document the same way, every time. That consistency is what makes the next step possible: files can be uploaded without anyone sorting or checking them by hand.</p>
              <span class="stat">Same naming, every file</span>
            </div>
            <div class="stage-visual">
              <div class="vis">
                <div class="vis-head">Renaming tool</div>
                <ul class="files">
                  <li style="--i:0"><span class="old">scan0042.pdf</span><span class="new">1042_Statement_2026-10.pdf</span></li>
                  <li style="--i:1"><span class="old">Document (3).pdf</span><span class="new">1042_Invoice_2026-10.pdf</span></li>
                  <li style="--i:2"><span class="old">IMG_2231.pdf</span><span class="new">2210_Notice_2026-09.pdf</span></li>
                </ul>
              </div>
            </div>
          </article>

          <!-- 6 · UPLOAD -->
          <article class="stage">
            <span class="node" aria-hidden="true">6</span>
            <div class="stage-text">
              <h3>Documents reach the website automatically</h3>
              <p>Renamed files are picked up and uploaded to our company website on their own. Compiling and uploading used to be manual work. It now runs in the background.</p>
              <span class="stat">7,000+ documents in two months</span>
            </div>
            <div class="stage-visual">
              <div class="vis term">
                <div class="vis-head"><span class="traffic"></span>auto-upload</div>
<pre><span class="c">$</span> watch renamed/
<span class="g">✓</span> new files found
<span class="g">✓</span> uploaded to website
<span class="g">✓</span> sheet updated</pre>
                <div class="bar"><span></span></div>
              </div>
            </div>
          </article>

          <!-- 7 · COMPLIANT -->
          <article class="stage">
            <span class="node" aria-hidden="true">7</span>
            <div class="stage-text">
              <h3>Compliant properties, fewer fees and liens</h3>
              <p>Because we know each property's status with its HOA, we stay current and compliant, and our clients avoid liens and late fees. These tools are what make that visibility possible across 6,000+ properties.</p>
              <span class="stat">$100k/month in late fees prevented</span>
            </div>
            <div class="stage-visual">
              <div class="vis">
                <div class="vis-head">Property status</div>
                <ul class="checks">
                  <li style="--i:0"><span>Account current</span><u class="good">✓</u></li>
                  <li style="--i:1"><span>HOA compliant</span><u class="good">✓</u></li>
                  <li style="--i:2"><span>Late fees avoided</span><u class="good">✓</u></li>
                  <li style="--i:3"><span>Lien avoided</span><u class="good">✓</u></li>
                </ul>
              </div>
            </div>
          </article>

          <div class="loop">
            <svg class="spin-slow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
            Manual work stopped. The syncing never does.
          </div>
        </div>
      </div>
    </section>

    <!-- 3. WORK EXPERIENCE SECTION -->
    <section id="experience" data-stack style="z-index:3" class="stack-card py-24 bg-canvas">
      <div class="side-deco" style="--ay:20%;--by:75%" aria-hidden="true">
        <div class="deco-card deco-left" style="top:6%;--d:-2s">
          <div class="card-head">SOP checklist</div>
          <ul class="tick"><li>Prepayments</li><li>Validation</li><li>Auto-Pull</li></ul>
        </div>

        <div class="deco-card deco-left" style="top:30%;--d:-5s">
          <div class="card-head">Team</div>
          <div class="dots"><i class="on"></i><i class="on"></i><i style="--i:0"></i><i style="--i:1"></i><i style="--i:2"></i><i style="--i:3"></i><i style="--i:4"></i><i style="--i:5"></i><i style="--i:6"></i></div>
          <div class="meta">2 → 9 people</div>
        </div>

        <div class="deco-card deco-left" style="top:56%;--d:-1s">
          <div class="card-head">Uploads</div>
          <div class="big">7,000+</div>
          <div class="meta">docs in 2 months</div>
        </div>

        <div class="deco-card deco-right" style="top:10%;--d:-3s">
          <div class="card-head"><span class="traffic"></span>pull.gs</div>
<pre><span class="k">const</span> data = <span class="f">partition</span>(
  assignees
);
hub.<span class="f">collect</span>(data);</pre>
        </div>

        <div class="deco-card deco-right" style="top:34%;--d:-4s">
          <div class="card-head">Late fees</div>
