        }
        // pause the looping stage visuals while they are off screen
        if (stages.length) {
          const io = new IntersectionObserver(
            (entries) => entries.forEach((e) => e.target.classList.toggle('offscreen', !e.isIntersecting)),
            { rootMargin: '160px 0px' }
          );
          stages.forEach((s) => io.observe(s));
        }
      } else if (dotNav) {
        dotNav.classList.add('is-visible');
      }

      // interactive side cards (Toolbox, Interest map): hover or click a tile; auto-cycles when idle
      const liveCards = Array.from(document.querySelectorAll<HTMLElement>('[data-cycle]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      liveCards.forEach((card) => {
        const picks = Array.from(card.querySelectorAll<HTMLButtonElement>('[data-pick]'));
        if (!picks.length) return;
        const kind = card.dataset.cycle;
        let current = 0;
        let lastTouch = 0;
        const restart = (el: Element | null, cls: string) => {
          if (!el) return;
          el.classList.remove(cls);
          void (el as HTMLElement).offsetWidth;
          el.classList.add(cls);
        };
        const show = (i: number) => {
          current = i;
          const pk = picks[i];
          picks.forEach((b, j) => b.classList.toggle('is-on', j === i));
          card.style.setProperty('--c', pk.dataset.c ?? '#9b5de5');
          if (kind === 'tools') {
            const name = card.querySelector<HTMLElement>('.tb-name');
            const note = card.querySelector<HTMLElement>('.tb-note');
            if (name) name.textContent = pk.dataset.title ?? '';
            if (note) note.textContent = pk.dataset.note ?? '';
            restart(name, 'swap-in');
            restart(note, 'swap-in');
            restart(card.querySelector('.tb-timer span'), 'run');
          } else {
            const tags = card.querySelector<HTMLElement>('.im-tags');
            if (tags) {
              tags.replaceChildren();
              const items = (pk.dataset.tags ?? '').split('|');
              const n = items.length;
              items.forEach((t, k) => {
                const it = document.createElement('span');
                it.className = 'it';
                it.textContent = n > 2 && k < n - 1 ? t + ',' : t;
                it.style.setProperty('--k', String(k));
                tags.appendChild(it);
                if (k < n - 1) {
                  const sep = document.createElement('span');
                  sep.className = 'sep';
                  sep.textContent = n === 2 || k === n - 2 ? ' and ' : ' ';
                  sep.style.setProperty('--k', String(k));
                  tags.appendChild(sep);
                }
              });
            }
          }
        };
        picks.forEach((pk, i) => {
          const touch = () => {
            lastTouch = Date.now();
            if (i !== current) show(i);
          };
          pk.addEventListener('mouseenter', touch);
          pk.addEventListener('click', touch);
        });
        show(0);
        if (!reduceMotion) {
          setInterval(() => {
            if (document.hidden) return;
            if (card.closest('.is-covered')) return;
            if (Date.now() - lastTouch < 6000) return;
            show((current + 1) % picks.length);
          }, 2800);
        }
      });

      // highlight strips: all graphics in a strip start together when it scrolls into view,
      // and the whole strip restarts together every cycle
      const strips = Array.from(document.querySelectorAll<HTMLElement>('.hl-strip'));
      const CYCLE_MS = 7000;
      if (strips.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        strips.forEach((el) => {
          el.classList.add('anim');
          let timer = 0;
          const run = () => {
            el.classList.remove('play');
            el.classList.add('reset');
            void el.offsetWidth;
            el.classList.remove('reset');
            el.classList.add('play');
          };
          new IntersectionObserver(
            ([entry]) => {
              window.clearInterval(timer);
              if (entry.isIntersecting) {
                run();
                timer = window.setInterval(run, CYCLE_MS);
              } else {
                el.classList.remove('play');
              }
            },
            { threshold: 0.35 }
          ).observe(el);
        });
      }

      new ResizeObserver(measure).observe(document.body);
      sections.forEach((el) => new ResizeObserver(measure).observe(el));
      window.addEventListener('resize', measure);
      window.addEventListener('load', measure);
      window.addEventListener('scroll', queue, { passive: true });
      measure();
    </script>
  </body>
</html>