    <script>
      // Sections taller than the screen stay in normal scroll until their bottom
      // edge reaches the bottom of the viewport, then pin, so no text is ever
      // covered before it has been seen. Shorter sections pin at the top.
      const sections = document.querySelectorAll<HTMLElement>('[data-stack]');

      const updateStickyOffsets = () => {
        const vh = window.innerHeight;
        sections.forEach((el) => {
          el.style.top = `${Math.min(0, vh - el.offsetHeight)}px`;
        });
      };

      const ro = new ResizeObserver(updateStickyOffsets);
      sections.forEach((el) => ro.observe(el));
      window.addEventListener('resize', updateStickyOffsets);
      updateStickyOffsets();

      // ---------- Progress bar + dot navigation ----------
      const bar = document.getElementById('scroll-progress');
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('#dot-nav a');

      // Where a section naturally starts in the page (ignores the sticky shift)
      const naturalTop = (index: number) => {
        let top = 0;
        for (let i = 0; i < index; i++) top += sections[i].offsetHeight;
        return top;
      };

      let ticking = false;

      const updateScrollUI = () => {
        ticking = false;

        const max = document.documentElement.scrollHeight - window.innerHeight;
        const progress = max > 0 ? window.scrollY / max : 0;
        if (bar) bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;

        const probe = window.scrollY + window.innerHeight * 0.4;
        let active = 0;
        for (let i = 0; i < sections.length; i++) {
          if (naturalTop(i) <= probe) active = i;
        }
        navLinks.forEach((link, i) => {
          link.classList.toggle('is-active', i === active);
          if (i === active) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateScrollUI);
        }
      };

      navLinks.forEach((link, i) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          window.scrollTo({ top: naturalTop(i), behavior: 'smooth' });
        });
      });

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      updateScrollUI();

      // ---------- Automation pipeline: spine fill + stage activation ----------
      const pipe = document.getElementById('pipe');
      if (pipe) {
        const pipeSection = pipe.closest('section');
        const spine = pipe.querySelector<HTMLElement>('.spine');
        const stages = Array.from(pipe.querySelectorAll<HTMLElement>('.stage'));
        let pipeQueued = false;

        const updatePipe = () => {
          pipeQueued = false;
          const vh = window.innerHeight;
          // The "reading line" the spine follows. It sits at 55% of the screen, then
          // slides to the bottom as the section reaches its pinned position, so the
          // last stage always lights up before the next section covers it.
          const secBottom = pipeSection ? pipeSection.getBoundingClientRect().bottom : vh;
          const k = Math.min(1, Math.max(0, (vh * 1.5 - secBottom) / (vh * 0.5)));
          const line = vh * 0.55 + vh * 0.45 * k;
          const r = spine ? spine.getBoundingClientRect() : pipe.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
          pipe.style.setProperty('--p', String(p));

          stages.forEach((s) => {
            const n = s.querySelector('.node')!.getBoundingClientRect();
            s.classList.toggle('reached', n.top + n.height / 2 < line);
          });
        };

        const queuePipe = () => {
          if (!pipeQueued) {
            pipeQueued = true;
            requestAnimationFrame(updatePipe);
          }
        };

        window.addEventListener('scroll', queuePipe, { passive: true });
        window.addEventListener('resize', queuePipe);
        updatePipe();
      }
    </script>
  </body>
</html>